DirectoryIndex index.php
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Keep the application, credentials and Composer dependencies outside HTTP access.
  RewriteRule ^portal(?:/|$) - [F,END]

  # These are the only public files served from Laravel's public directory.
  RewriteRule ^(install\.php|portal\.css|bootstrap\.min\.css|bootstrap\.bundle\.min\.js|favicon\.ico|robots\.txt)$ portal/public/$1 [END]

  # Keep legacy moderation and webhook endpoints available during migration.
  RewriteRule ^(mod|appeal|api|bans/api)(?:/|$) - [L]

  # The old static landing must never win DirectoryIndex or a direct request.
  RewriteRule ^index\.html$ ./ [R=302,L]
  RewriteRule ^bans/?$ index.php [L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.php [L]
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(html|php)$">
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
  </FilesMatch>
</IfModule>
